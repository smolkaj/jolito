# Supabase Configuration for Cloud Sync ($0 Permanent Free Tier)
# If not configured, Jolito runs 100% offline with local storage & manual JSON backup.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Infrastructure & Automation Secrets (for 'npm run setup:domain' / 'npm run setup:email')
# SUPABASE_ACCESS_TOKEN=your-supabase-access-token  # Defaults to ~/.supabase/access-token
# RESEND_API_KEY=re_your_resend_api_key           # For custom SMTP & automated DKIM/SPF DNS
# FEEDBACK_NOTIFICATION_EMAIL=you@example.com      # Destination for feedback & sign-in replies

