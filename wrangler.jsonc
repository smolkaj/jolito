{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jolito",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "joli.to",
      "custom_domain": true,
    },
  ],
}
