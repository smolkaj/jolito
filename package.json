{
  "name": "jolito",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "lint": "eslint --cache --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:db": "npx supabase test db",
    "lint:db": "npx supabase db lint --local --fail-on error",
    "test:integration": "vitest run tests/integration",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:release && npm run build && npm run build:signup-alerts",
    "build:signup-alerts": "wrangler deploy --config wrangler.signup-alerts.json --dry-run",
    "generate:privacy": "node scripts/generate-privacy-html.ts",
    "query:telemetry": "node scripts/query-telemetry.ts",
    "build": "node scripts/generate-privacy-html.ts && vite build",
    "preview": "vite preview",
    "preview:wait": "node scripts/preview-wait.ts",
    "ingest:dict": "python3 scripts/ingest-wiktionary.py",
    "setup:domain": "node scripts/setup-domain.ts",
    "deploy:signup-alerts": "node scripts/deploy-signup-alerts.ts",
    "setup:auth": "node scripts/supabase-auth-config.ts",
    "setup:email": "node scripts/setup-email.ts",
    "generate:seo": "node scripts/generate-seo-assets.ts",
    "generate:splash": "node scripts/generate-splash-screens.ts",
    "generate:screenshots": "node --experimental-strip-types scripts/generate-store-screenshots.ts",
    "build:favicons": "node scripts/build-favicons.mjs",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler versions upload",
    "test:release": "node --test tests/release/*.test.ts",
    "pr:merge": "node scripts/merge-coordinator.ts",
    "agent:worktree": "node scripts/agent-worktree.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "fflate": "^0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sql.js": "^1.14.2",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "undici": "^8.10.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "4.135.0"
  }
}
