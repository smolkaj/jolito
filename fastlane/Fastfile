require_relative 'release_config'
require 'tmpdir'
require 'securerandom'
require 'fileutils'
require 'open3'
require 'plist'

default_platform(:ios)

platform :ios do
  private_lane :connect do
    ReleaseConfig.api!
    app_store_connect_api_key(
      key_id: ENV.fetch('APP_STORE_CONNECT_API_KEY_KEY_ID'),
      issuer_id: ENV.fetch('APP_STORE_CONNECT_API_KEY_ISSUER_ID'),
      key_content: ENV.fetch('APP_STORE_CONNECT_API_KEY_KEY'),
      is_key_content_base64: true
    )
  end

  desc 'Build, sign and upload one uniquely numbered TestFlight candidate'
  lane :beta do
    ReleaseConfig.build!
    connect
    settings = ReleaseConfig::SETTINGS
    version = settings.fetch('version')
    bundle_id = settings.fetch('bundleId')
    number = ReleaseConfig.build_number!(latest_testflight_build_number(
      app_identifier: bundle_id, version: version, initial_build_number: 0
    ) + 1)

    Dir.mktmpdir('jolito-signing-') do |temp|
      keychain = File.join(temp, 'release.keychain-db')
      password = SecureRandom.hex(32)
      profile_path = nil
      widget_installed_path = nil
      widget_bundle_id = 'to.joli.app.JolitoWidgetExtension'
      widget_profile_file = File.join(temp, 'widget.mobileprovision')
      widget_uuid = nil
      begin
        certificate = File.join(temp, 'distribution.p12')
        profile_file = File.join(temp, 'distribution.mobileprovision')
        File.binwrite(certificate, Base64.strict_decode64(ENV.fetch('APPLE_CERTIFICATE_P12')))
        if ENV['APPLE_PROVISIONING_PROFILE'] && !ENV['APPLE_PROVISIONING_PROFILE'].strip.empty?
          File.binwrite(profile_file, Base64.strict_decode64(ENV.fetch('APPLE_PROVISIONING_PROFILE')))
        end

        # Resolve or auto-provision main app profile with Sign In with Apple capability
        need_app_provision = !File.exist?(profile_file)
        if File.exist?(profile_file)
          File.chmod(0600, profile_file)
          xml_check, check_status = Open3.capture2('security', 'cms', '-D', '-i', profile_file)
          if check_status.success?
            parsed_check = Plist.parse_xml(xml_check)
            need_app_provision = parsed_check.dig('Entitlements', 'com.apple.developer.applesignin').nil?
          else
            need_app_provision = true
          end
        end

        if need_app_provision
          if ENV['APP_STORE_CONNECT_API_KEY_KEY']
            provision_app_script = File.join(ReleaseConfig::ROOT, 'scripts/provision-app.ts')
            if File.exist?(provision_app_script)
              UI.message('Auto-provisioning Jolito AppStore profile with Sign In with Apple via App Store Connect API...')
              output, prov_status = Open3.capture2e('node', provision_app_script, '--output', profile_file)
              UI.message(output) if output && !output.empty?
              UI.user_error!('Failed to auto-provision app profile') unless prov_status.success?
            end
          else
            UI.user_error!('App Store provisioning profile lacks Sign In with Apple capability (com.apple.developer.applesignin) and cannot be auto-provisioned without App Store Connect API keys')
          end
        end

        File.chmod(0600, certificate, profile_file)
        xml, status = Open3.capture2('security', 'cms', '-D', '-i', profile_file)
        UI.user_error!('Cannot decode provisioning profile') unless status.success?
        profile = Plist.parse_xml(xml)
        uuid = ReleaseConfig.profile!(profile)
        profile_path = install_provisioning_profile(path: profile_file)

        # Resolve or auto-provision widget extension profile
        if ENV['APPLE_WIDGET_PROVISIONING_PROFILE'] && !ENV['APPLE_WIDGET_PROVISIONING_PROFILE'].strip.empty?
          File.binwrite(widget_profile_file, Base64.strict_decode64(ENV.fetch('APPLE_WIDGET_PROVISIONING_PROFILE')))
        elsif ENV['APP_STORE_CONNECT_API_KEY_KEY']
          provision_script = File.join(ReleaseConfig::ROOT, 'scripts/provision-widget.ts')
          if File.exist?(provision_script)
            UI.message('Auto-provisioning JolitoWidgetExtension profile via App Store Connect API...')
            output, prov_status = Open3.capture2e('node', provision_script, '--output', widget_profile_file)
            UI.message(output) if output && !output.empty?
            UI.user_error!('Failed to auto-provision widget extension profile') unless prov_status.success?
          end
        end

        if File.exist?(widget_profile_file)
          File.chmod(0600, widget_profile_file)
          widget_xml, widget_status = Open3.capture2('security', 'cms', '-D', '-i', widget_profile_file)
          UI.user_error!('Cannot decode widget provisioning profile') unless widget_status.success?
          parsed_widget_profile = Plist.parse_xml(widget_xml)
          widget_uuid = ReleaseConfig.profile!(parsed_widget_profile, ENV, widget_bundle_id)
          widget_installed_path = install_provisioning_profile(path: widget_profile_file)
        end

        create_keychain(path: keychain, password: password, default_keychain: true,
                        unlock: true, timeout: 3600, add_to_search_list: true)
        import_certificate(certificate_path: certificate,
                           certificate_password: ENV.fetch('APPLE_CERTIFICATE_PASS'),
                           keychain_path: keychain, keychain_password: password)
        _, partition_status = Open3.capture2(
          'security', 'set-key-partition-list', '-S', 'apple-tool:,apple:,codesign:', '-s', '-k', password, keychain
        )
        UI.user_error!('Cannot set keychain partition list') unless partition_status.success?
        UI.user_error!('JolitoWidgetExtension provisioning profile could not be resolved') unless widget_uuid

        update_code_signing_settings(
          use_automatic_signing: false, path: File.join(ReleaseConfig::ROOT, 'ios/App/App.xcodeproj'),
          targets: ['App'], build_configurations: ['Release'],
          team_id: ENV.fetch('APPLE_TEAM_ID'), code_sign_identity: 'Apple Distribution',
          profile_uuid: uuid, bundle_identifier: bundle_id
        )
        update_code_signing_settings(
          use_automatic_signing: false, path: File.join(ReleaseConfig::ROOT, 'ios/App/App.xcodeproj'),
          targets: ['JolitoWidgetExtension'], build_configurations: ['Release'],
          team_id: ENV.fetch('APPLE_TEAM_ID'), code_sign_identity: 'Apple Distribution',
          profile_uuid: widget_uuid, bundle_identifier: widget_bundle_id
        )

        provisioning_profiles = {
          bundle_id => uuid,
          widget_bundle_id => widget_uuid
        }

        build_app(
          project: File.join(ReleaseConfig::ROOT, 'ios/App/App.xcodeproj'), scheme: 'App', configuration: 'Release',
          export_method: 'app-store', output_directory: File.join(ReleaseConfig::ROOT, 'build'), output_name: 'Jolito.ipa',
          clean: true,
          xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{number} CODE_SIGN_IDENTITY=\"Apple Distribution\"",
          export_options: {
            signingStyle: 'manual', teamID: ENV.fetch('APPLE_TEAM_ID'),
            provisioningProfiles: provisioning_profiles, manageAppVersionAndBuildNumber: false
          }
        )
        upload_to_testflight(
          app_identifier: bundle_id, ipa: File.join(ReleaseConfig::ROOT, 'build/Jolito.ipa'),
          changelog: "#{ENV.fetch('RELEASE_NOTES', 'Initial paid release')}\nSource: #{ENV.fetch('GITHUB_SHA', 'local')}",
          skip_waiting_for_build_processing: false
        )
        build_dir = File.join(ReleaseConfig::ROOT, 'build')
        FileUtils.mkdir_p(build_dir)
        File.write(File.join(build_dir, 'release.json'), JSON.pretty_generate({
          bundleId: bundle_id, version: version, buildNumber: number,
          commit: ENV.fetch('GITHUB_SHA', 'local')
        }))
      ensure
        begin
          delete_keychain(keychain_path: keychain) if File.exist?(keychain)
        ensure
          FileUtils.rm_f(profile_path) if profile_path
          FileUtils.rm_f(widget_installed_path) if widget_installed_path
        end
      end
    end
  end

  desc 'Submit the explicit TestFlight build; never rebuild or choose latest'
  lane :release do |options|
    number = ReleaseConfig.build_number!(options[:build_number])
    connect
    script = File.join(ReleaseConfig::ROOT, 'scripts/app-store.ts')
    output, status = Open3.capture2e('node', script, '--submit', number)
    UI.message(output) if output && !output.empty?
    UI.user_error!("Failed to submit App Store build #{number}") unless status.success?
  end

  desc 'Upload reviewed listing copy and native screenshots without a binary'
  lane :metadata do
    connect
    UI.user_error!('Capture and review native screenshots first; see docs/APP_STORE.md') unless File.directory?(File.join(ReleaseConfig::ROOT, 'fastlane/native-screenshots/en-US'))
    upload_to_app_store(
      app_identifier: ReleaseConfig::SETTINGS.fetch('bundleId'),
      app_version: ReleaseConfig::SETTINGS.fetch('version'),
      screenshots_path: File.join(ReleaseConfig::ROOT, 'fastlane/native-screenshots'),
      metadata_path: File.join(ReleaseConfig::ROOT, 'fastlane/metadata'),
      skip_binary_upload: true, submit_for_review: false,
      precheck_include_in_app_purchases: false, force: true
    )
  end
end

platform :android do
  desc 'Build release Android App Bundle (AAB)'
  lane :build do
    gradle(
      task: 'bundleRelease',
      project_dir: 'android/'
    )
  end

  desc 'Upload release bundle and metadata to Google Play track (internal, closed, production)'
  lane :deploy do |options|
    track = options[:track] || 'internal'
    build unless options[:skip_build]
    supply(
      package_name: ReleaseConfig::SETTINGS.fetch('bundleId'),
      track: track,
      aab: File.join(ReleaseConfig::ROOT, 'android/app/build/outputs/bundle/release/app-release.aab'),
      metadata_path: File.join(ReleaseConfig::ROOT, 'fastlane/metadata/android'),
      json_key: ENV['SUPPLY_JSON_KEY'],
      json_key_data: ENV['SUPPLY_JSON_KEY_DATA']
    )
  end

  desc 'Upload release bundle to Google Play Internal Testing'
  lane :internal do |options|
    deploy(track: 'internal', skip_build: options[:skip_build])
  end

  desc 'Upload release bundle to Google Play Closed Testing'
  lane :closed do |options|
    deploy(track: 'closed', skip_build: options[:skip_build])
  end

  desc 'Upload release bundle to Google Play Production track'
  lane :production do |options|
    deploy(track: 'production', skip_build: options[:skip_build])
  end

  desc 'Upload release bundle to Google Play Production track (alias for production)'
  lane :release do |options|
    deploy(track: 'production', skip_build: options[:skip_build])
  end

  desc 'Upload Google Play listing metadata and screenshots without a binary'
  lane :metadata do
    supply(
      package_name: ReleaseConfig::SETTINGS.fetch('bundleId'),
      skip_upload_aab: true,
      skip_upload_apk: true,
      metadata_path: File.join(ReleaseConfig::ROOT, 'fastlane/metadata/android'),
      json_key: ENV['SUPPLY_JSON_KEY'],
      json_key_data: ENV['SUPPLY_JSON_KEY_DATA']
    )
  end
end

